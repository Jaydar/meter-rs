import { Palette } from "std-widgets.slint";
import { MenuItem } from "widget/menu-item.slint";

export component SubmenuWindow inherits Window {
    width: 210px;
    height: content.preferred-height;
    background: transparent;
    no-frame: true;
    always-on-top: true;

    in-out property <int> mode: 0;
    in-out property <int> theme_state: 0;
    in-out property <bool> show_cpu_state: true;
    in-out property <bool> show_memory_state: true;
    in-out property <bool> show_disk_usage_state: true;
    in-out property <bool> show_network_state: true;
    in-out property <bool> show_disk_io_state: true;
    in-out property <bool> always_on_top_state: true;
    in-out property <bool> snap_to_edge_state: true;
    in-out property <float> opacity_value: 0.9;

    callback close_menu();
    callback set_theme(int);
    callback set_show_cpu(bool);
    callback set_show_memory(bool);
    callback set_show_disk_usage(bool);
    callback set_show_network(bool);
    callback set_show_disk_io(bool);
    callback set_always_on_top(bool);
    callback set_snap_to_edge(bool);
    callback set_opacity(float);

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 14px;

        content := VerticalLayout {
            padding: 8px;
            spacing: 2px;

            if (root.mode == 1) : MenuItem {
                text: "深色";
                checked: root.theme_state == 0;
                clicked => {
                    root.theme_state = 0;
                    root.set_theme(0);
                    root.close_menu();
                }
            }
            if (root.mode == 1) : MenuItem {
                text: "浅色";
                checked: root.theme_state == 1;
                clicked => {
                    root.theme_state = 1;
                    root.set_theme(1);
                    root.close_menu();
                }
            }

            if (root.mode == 2) : MenuItem {
                text: "CPU";
                checked: root.show_cpu_state;
                clicked => {
                    root.show_cpu_state = !root.show_cpu_state;
                    root.set_show_cpu(root.show_cpu_state);
                    root.close_menu();
                }
            }
            if (root.mode == 2) : MenuItem {
                text: "内存";
                checked: root.show_memory_state;
                clicked => {
                    root.show_memory_state = !root.show_memory_state;
                    root.set_show_memory(root.show_memory_state);
                    root.close_menu();
                }
            }
            if (root.mode == 2) : MenuItem {
                text: "磁盘";
                checked: root.show_disk_usage_state;
                clicked => {
                    root.show_disk_usage_state = !root.show_disk_usage_state;
                    root.set_show_disk_usage(root.show_disk_usage_state);
                    root.close_menu();
                }
            }
            if (root.mode == 2) : MenuItem {
                text: "流量";
                checked: root.show_network_state;
                clicked => {
                    root.show_network_state = !root.show_network_state;
                    root.set_show_network(root.show_network_state);
                    root.close_menu();
                }
            }
            if (root.mode == 2) : MenuItem {
                text: "磁盘读写";
                checked: root.show_disk_io_state;
                clicked => {
                    root.show_disk_io_state = !root.show_disk_io_state;
                    root.set_show_disk_io(root.show_disk_io_state);
                    root.close_menu();
                }
            }

            if (root.mode == 3) : MenuItem {
                text: "总是置顶";
                checked: root.always_on_top_state;
                clicked => {
                    root.always_on_top_state = !root.always_on_top_state;
                    root.set_always_on_top(root.always_on_top_state);
                    root.close_menu();
                }
            }
            if (root.mode == 3) : MenuItem {
                text: "靠边吸附";
                checked: root.snap_to_edge_state;
                clicked => {
                    root.snap_to_edge_state = !root.snap_to_edge_state;
                    root.set_snap_to_edge(root.snap_to_edge_state);
                    root.close_menu();
                }
            }
            if (root.mode == 3) : Rectangle { height: 1px; background: Palette.border; }
            if (root.mode == 3) : MenuItem {
                text: "透明度 100%";
                checked: root.opacity_value == 1.0;
                clicked => {
                    root.opacity_value = 1.0;
                    root.set_opacity(1.0);
                    root.close_menu();
                }
            }
            if (root.mode == 3) : MenuItem {
                text: "透明度 90%";
                checked: root.opacity_value == 0.9;
                clicked => {
                    root.opacity_value = 0.9;
                    root.set_opacity(0.9);
                    root.close_menu();
                }
            }
            if (root.mode == 3) : MenuItem {
                text: "透明度 75%";
                checked: root.opacity_value == 0.75;
                clicked => {
                    root.opacity_value = 0.75;
                    root.set_opacity(0.75);
                    root.close_menu();
                }
            }
            if (root.mode == 3) : MenuItem {
                text: "透明度 60%";
                checked: root.opacity_value == 0.6;
                clicked => {
                    root.opacity_value = 0.6;
                    root.set_opacity(0.6);
                    root.close_menu();
                }
            }
            if (root.mode == 3) : MenuItem {
                text: "透明度 45%";
                checked: root.opacity_value == 0.45;
                clicked => {
                    root.opacity_value = 0.45;
                    root.set_opacity(0.45);
                    root.close_menu();
                }
            }
        }
    }
}
