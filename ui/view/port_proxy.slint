import "../assets/remixicon.ttf";
import { Button, ComboBox, LineEdit, ListView, Spinner } from "std-widgets.slint";
import { PortProxyEntry } from "../runtime_store.slint";
import { Theme } from "../theme.slint";

component IconButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: icon_ta.has-hover ? Theme.menu-hover-bg : transparent;

    icon_ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    Text { width: 100%; height: 100%; text: root.icon; color: icon_ta.has-hover ? Theme.menu-hover-fg : Theme.text; font-size: 16px; font-family: "remixicon"; vertical-alignment: center; horizontal-alignment: center; }
}

export component PortProxyWindow inherits Window {
    width: 504px;
    height: 540px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-size: 10pt;

    in-out property <[PortProxyEntry]> port_proxies: [];
    in-out property <bool> add_dialog_visible: false;
    in-out property <bool> edit_mode: false;
    in-out property <string> edit_proxy_type;
    in-out property <string> edit_listen_address;
    in-out property <string> edit_listen_port;
    in-out property <bool> delete_dialog_visible: false;
    in-out property <bool> reset_dialog_visible: false;
    in-out property <int> add_proxy_type_index: 0;
    in-out property <string> add_listen_address: "0.0.0.0";
    in-out property <string> add_listen_port;
    in-out property <string> add_connect_address;
    in-out property <string> add_connect_port;
    in-out property <string> delete_listen_address;
    in-out property <string> delete_listen_port;
    in-out property <string> delete_proxy_type;
    in-out property <string> status_text;
    in-out property <bool> loading_visible: false;
    out property <[string]> proxy_types: ["V4 to V4", "V4 to V6", "V6 to V4", "V6 to V6"];
    out property <string> add_proxy_type: root.add_proxy_type_index >= 0 && root.add_proxy_type_index < root.proxy_types.length ? root.proxy_types[root.add_proxy_type_index] : "V4 to V4";

    callback win_move(length, length);
    callback close_port_proxy();
    callback add_port_proxy(string, string, string, string, string);
    callback edit_port_proxy(string, string, string, string, string, string, string, string);
    callback delete_port_proxy(string, string, string);
    callback reset_port_proxies();

    Rectangle {
        width: 100%; height: 100%; border-radius: 10px; background: Theme.window-bg; border-width: 1px; border-color: Theme.menu-border;
        VerticalLayout {
            padding: 12px; spacing: 8px;
            Rectangle {
                height: 28px;
                title_ta := TouchArea { width: 100%; height: 100%; mouse-cursor: self.pressed ? MouseCursor.move : MouseCursor.default; moved => { root.win_move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
                HorizontalLayout {
                    Text { text: "端口转发"; color: Theme.title; font-size: 12pt; font-weight: 800; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { height: 28px; text: "清理"; clicked => { root.reset_dialog_visible = true; } }
                    IconButton { icon: "\u{ea13}"; clicked => { root.edit_mode = false; root.add_dialog_visible = true; } }
                    IconButton { icon: "\u{eb99}"; clicked => { root.close_port_proxy(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.menu-border; }
            VerticalLayout {
                vertical-stretch: 1; spacing: 4px;
                Rectangle { height: 22px; HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px; Text { width: 52px; text: "类型"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; } Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: "监听地址"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; } Text { width: 60px; text: "监听端口"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; } Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: "目标地址"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; } Text { width: 60px; text: "目标端口"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; } Text { width: 28px; text: "操作"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; } } }
                ListView {
                    vertical-stretch: 1;
                    for port_proxy in root.port_proxies: Rectangle { height: 38px; HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 4px; Text { width: 52px; text: port_proxy.proxy_type; color: Theme.text; font-size: 9pt; vertical-alignment: center; } Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 100%; Text { width: 100%; height: 100%; text: port_proxy.listen_address; color: Theme.text; font-size: 9pt; vertical-alignment: center; overflow: elide; } } Text { width: 60px; text: port_proxy.listen_port; color: Theme.text; font-size: 9pt; vertical-alignment: center; } Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 100%; Text { width: 100%; height: 100%; text: port_proxy.connect_address; color: Theme.text; font-size: 9pt; vertical-alignment: center; overflow: elide; } } Text { width: 60px; text: port_proxy.connect_port; color: Theme.text; font-size: 9pt; vertical-alignment: center; } Rectangle { width: 56px; height: 100%; HorizontalLayout { IconButton { y: (parent.height - self.height) / 2; icon: "\u{f0e5}"; clicked => { root.edit_mode = true; root.add_proxy_type_index = port_proxy.proxy_type == "V4 to V6" ? 1 : port_proxy.proxy_type == "V6 to V4" ? 2 : port_proxy.proxy_type == "V6 to V6" ? 3 : 0; root.add_listen_address = port_proxy.listen_address; root.add_listen_port = port_proxy.listen_port; root.add_connect_address = port_proxy.connect_address; root.add_connect_port = port_proxy.connect_port; root.edit_proxy_type = port_proxy.proxy_type; root.edit_listen_address = port_proxy.listen_address; root.edit_listen_port = port_proxy.listen_port; root.add_dialog_visible = true; } } IconButton { y: (parent.height - self.height) / 2; icon: "\u{eb99}"; clicked => { root.delete_proxy_type = port_proxy.proxy_type; root.delete_listen_address = port_proxy.listen_address; root.delete_listen_port = port_proxy.listen_port; root.delete_dialog_visible = true; } } } } } Rectangle { width: 100%; height: 1px; y: parent.height - 1px; background: Theme.menu-border; } }
                }
            }
        }

        if (root.delete_dialog_visible): Rectangle { width: 100%; height: 100%; background: #00000066; Rectangle { width: 300px; height: 128px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 8px; background: Theme.card-bg; border-width: 1px; border-color: Theme.menu-border; VerticalLayout { padding: 14px; spacing: 10px; Text { text: "确认删除端口转发 " + root.delete_listen_address + ":" + root.delete_listen_port + " 吗？"; color: Theme.text; font-size: 10pt; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; background: transparent; } Button { height: 26px; text: "取消"; clicked => { root.delete_dialog_visible = false; } } Button { height: 26px; text: "删除"; primary: true; clicked => { root.delete_dialog_visible = false; root.delete_port_proxy(root.delete_proxy_type, root.delete_listen_address, root.delete_listen_port); } } } } } }

        if (root.reset_dialog_visible): Rectangle { width: 100%; height: 100%; background: #00000066; Rectangle { width: 300px; height: 128px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 8px; background: Theme.card-bg; border-width: 1px; border-color: Theme.menu-border; VerticalLayout { padding: 14px; spacing: 10px; Text { text: "确认清理全部端口转发吗？"; color: Theme.text; font-size: 10pt; wrap: word-wrap; } Rectangle { vertical-stretch: 1; background: transparent; } HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; background: transparent; } Button { height: 26px; text: "取消"; clicked => { root.reset_dialog_visible = false; } } Button { height: 26px; text: "清理"; primary: true; clicked => { root.reset_dialog_visible = false; root.reset_port_proxies(); } } } } } }

        if (root.add_dialog_visible): Rectangle { width: 100%; height: 100%; background: #00000066; Rectangle { width: 384px; height: 310px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 8px; background: Theme.card-bg; border-width: 1px; border-color: Theme.menu-border; VerticalLayout { padding: 14px; spacing: 10px; HorizontalLayout { Text { text: root.edit_mode ? "修改端口转发" : "新增端口转发"; color: Theme.title; font-size: 11pt; font-weight: 800; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } IconButton { icon: "\u{eb99}"; clicked => { root.add_dialog_visible = false; } } } HorizontalLayout { spacing: 8px; Text { width: 68px; text: "类型"; color: Theme.text; font-size: 9pt; vertical-alignment: center; horizontal-alignment: right; } ComboBox { height: 28px; model: root.proxy_types; current-index <=> root.add_proxy_type_index; } } HorizontalLayout { spacing: 8px; Text { width: 68px; text: "监听地址"; color: Theme.text; font-size: 9pt; vertical-alignment: center; horizontal-alignment: right; } LineEdit { height: 28px; text <=> root.add_listen_address; placeholder-text: "0.0.0.0"; } } HorizontalLayout { spacing: 8px; Text { width: 68px; text: "监听端口"; color: Theme.text; font-size: 9pt; vertical-alignment: center; horizontal-alignment: right; } LineEdit { height: 28px; text <=> root.add_listen_port; placeholder-text: "8085"; } } HorizontalLayout { spacing: 8px; Text { width: 68px; text: "目标地址"; color: Theme.text; font-size: 9pt; vertical-alignment: center; horizontal-alignment: right; } LineEdit { height: 28px; text <=> root.add_connect_address; placeholder-text: "192.168.137.2"; } } HorizontalLayout { spacing: 8px; Text { width: 68px; text: "目标端口"; color: Theme.text; font-size: 9pt; horizontal-alignment: right; } LineEdit { height: 28px; text <=> root.add_connect_port; placeholder-text: "8085"; } } Rectangle { vertical-stretch: 1; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { height: 28px; text: "保存"; primary: true; enabled: root.add_listen_address != "" && root.add_listen_port != "" && root.add_connect_address != "" && root.add_connect_port != ""; clicked => { root.edit_mode ? root.edit_port_proxy(root.edit_proxy_type, root.edit_listen_address, root.edit_listen_port, root.add_proxy_type, root.add_listen_address, root.add_listen_port, root.add_connect_address, root.add_connect_port) : root.add_port_proxy(root.add_proxy_type, root.add_listen_address, root.add_listen_port, root.add_connect_address, root.add_connect_port); } } Rectangle { horizontal-stretch: 1; } } } } }

        if (root.status_text != ""): Rectangle { width: 100%; height: 100%; background: #00000066; Rectangle { width: 360px; height: 128px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 8px; background: Theme.card-bg; border-width: 1px; border-color: Theme.menu-border; VerticalLayout { padding: 14px; spacing: 10px; Text { text: root.status_text; color: Theme.text; font-size: 10pt; wrap: word-wrap; } Rectangle { vertical-stretch: 1; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { height: 26px; text: "确定"; primary: true; clicked => { root.status_text = ""; } } } } } }

        if (root.loading_visible): Rectangle { width: 100%; height: 100%; background: #00000099; Spinner { width: 36px; height: 36px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; indeterminate: true; } }
    }
}
