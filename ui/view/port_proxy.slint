import {
    Button,
    ComboBox,
    LineEdit,
    Spinner,
    Palette,
    StyleMetrics,
} from "std-widgets.slint";
import { PortProxyEntry } from "../runtime_store.slint";
import { Page } from "widget/page.slint";
import { IconButton } from "widget/icon_button.slint";
import { CenteredTableView, TableViewCell, TableViewRow } from "widget/table_view.slint";

export component PortProxyWindow inherits Page {
    title: "端口转发";
    // width: 540px;
    preferred-width: 600px;
    preferred-height: 400px;
    background: Palette.background;

    in-out property <[PortProxyEntry]> port_proxies: [];
    in-out property <int> current_row: -1;
    private property <bool> has_selection: root.current_row >= 0 && root.current_row < root.port_proxies.length;
    in-out property <bool> add_dialog_visible: false;
    in-out property <bool> edit_mode: false;
    in-out property <string> edit_proxy_type;
    in-out property <string> edit_listen_address;
    in-out property <string> edit_listen_port;
    in-out property <bool> delete_dialog_visible: false;
    in-out property <bool> reset_dialog_visible: false;
    resize-border-width: 0px;
    in-out property <int> add_proxy_type_index: 0;
    in-out property <string> add_listen_address: "0.0.0.0";
    in-out property <string> add_listen_port;
    in-out property <string> add_connect_address;
    in-out property <string> add_connect_port;
    in-out property <string> delete_listen_address;
    in-out property <string> delete_listen_port;
    in-out property <string> delete_proxy_type;
    in-out property <string> status_text;
    in-out property <bool> loading_visible: false;
    out property <[string]> proxy_types: ["V4 to V4", "V4 to V6", "V6 to V4", "V6 to V6"];
    out property <string> add_proxy_type: root.add_proxy_type_index >= 0 && root.add_proxy_type_index < root.proxy_types.length ? root.proxy_types[root.add_proxy_type_index] : "V4 to V4";

    callback close_port_proxy();
    callback add_port_proxy(string, string, string, string, string);
    callback edit_port_proxy(string, string, string, string, string, string, string, string);
    callback delete_port_proxy(string, string, string);
    callback reset_port_proxies();

    content:= Rectangle {
        width: 100%;
        height: 100%;
        // background: Palette.background;
        border-radius: 10px;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    horizontal-stretch: 1;
                    text: root.port_proxies.length + " 条转发规则";
                    font-size: 9pt;
                    vertical-alignment: center;
                    color: Palette.control-foreground;
                }

                IconButton {
                    icon: "\u{eb99}";
                    clicked => { root.reset_dialog_visible = true; }
                }

                IconButton {
                    icon: "\u{ea13}";
                    clicked => { root.edit_mode = false; root.add_dialog_visible = true; }
                }
            }

            Rectangle {
                height: 1px;
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    table := CenteredTableView {
                        width: 100%;
                        height: 100%;
                        columns: [
                            {
                                title: "类型",
                                width: 80px,
                                header: { height: 36px, alignment: center },
                                body: { height: 34px, alignment: center },
                            },
                            {
                                title: "监听地址",
                                min-width: 120px,
                                header: { alignment: left },
                                body: { alignment: left },
                            },
                            {
                                title: "监听端口",
                                width: 80px,
                                header: { alignment: center },
                                body: { alignment: center },
                            },
                            {
                                title: "目标地址",
                                min-width: 120px,
                                header: { alignment: left },
                                body: { alignment: left },
                            },
                            {
                                title: "目标端口",
                                width: 80px,
                                header: { alignment: center },
                                body: { alignment: center },
                            },
                            {
                                title: "操作",
                                width: 80px,
                                horizontal-stretch: 0,
                                sortable: false,
                                header: { alignment: center },
                                body: { alignment: center, action-spacing: 0px },
                            },
                        ];
                        current-row <=> root.current_row;
                        custom-body: true;

                        for proxy[idx] in root.port_proxies : TableViewRow {
                            selected: idx == table.current-row;
                            even: mod(idx, 2) == 0;
                            row-height: 34px;

                            clicked => { table.set-current-row(idx); }

                            for column[ci] in table.columns : TableViewCell {
                                column: column;

                                if (ci == table.columns.length - 1) : HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    alignment: center;
                                    cross-axis-alignment: center;
                                    spacing: column.body.action-spacing;

                                    IconButton {
                                        width: 20px;
                                        icon: "\u{f0e5}";
                                        clicked => {
                                            root.edit_mode = true;
                                            root.add_proxy_type_index = proxy.proxy_type == "V4 to V6" ? 1 : proxy.proxy_type == "V6 to V4" ? 2 : proxy.proxy_type == "V6 to V6" ? 3 : 0;
                                            root.add_listen_address = proxy.listen_address;
                                            root.add_listen_port = proxy.listen_port;
                                            root.add_connect_address = proxy.connect_address;
                                            root.add_connect_port = proxy.connect_port;
                                            root.edit_proxy_type = proxy.proxy_type;
                                            root.edit_listen_address = proxy.listen_address;
                                            root.edit_listen_port = proxy.listen_port;
                                            root.add_dialog_visible = true;
                                        }
                                    }

                                    IconButton {
                                        width: 20px;
                                        icon: "\u{eb99}";
                                        clicked => {
                                            root.delete_proxy_type = proxy.proxy_type;
                                            root.delete_listen_address = proxy.listen_address;
                                            root.delete_listen_port = proxy.listen_port;
                                            root.delete_dialog_visible = true;
                                        }
                                    }
                                }
                                if (ci != table.columns.length - 1) : Text {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    vertical-alignment: center;
                                    horizontal-alignment: column.body.alignment;
                                    overflow: elide;
                                    text: ci == 0 ? proxy.proxy_type : ci == 1 ? proxy.listen_address : ci == 2 ? proxy.listen_port : ci == 3 ? proxy.connect_address : proxy.connect_port;
                                }
                            }
                        }
                    }
                }
            }
        }

        if (root.delete_dialog_visible): Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;
            Rectangle {
                width: 300px;
                height: 128px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: "确认删除端口转发 " + root.delete_listen_address + ":" + root.delete_listen_port + " 吗？";
                        font-size: 10pt;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Button {
                            height: 26px;
                            text: "取消";
                            clicked => { root.delete_dialog_visible = false; }
                        }

                        Button {
                            height: 26px;
                            text: "删除";
                            primary: true;
                            clicked => { root.delete_dialog_visible = false; root.delete_port_proxy(root.delete_proxy_type, root.delete_listen_address, root.delete_listen_port); }
                        }
                    }
                }
            }
        }

        if (root.reset_dialog_visible): Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;
            Rectangle {
                width: 300px;
                height: 128px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: "确认清理全部端口转发吗？";
                        font-size: 10pt;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Button {
                            height: 26px;
                            text: "取消";
                            clicked => { root.reset_dialog_visible = false; }
                        }

                        Button {
                            height: 26px;
                            text: "清理";
                            primary: true;
                            clicked => { root.reset_dialog_visible = false; root.reset_port_proxies(); }
                        }
                    }
                }
            }
        }

        if (root.add_dialog_visible): Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;
            Rectangle {
                width: 384px;
                height: 310px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: root.edit_mode ? "修改端口转发" : "新增端口转发";
                            font-size: 11pt;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: "\u{eb99}";
                            clicked => { root.add_dialog_visible = false; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 68px;
                            text: "类型";
                            font-size: 9pt;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }

                        ComboBox {
                            height: 28px;
                            model: root.proxy_types;
                            current-index <=> root.add_proxy_type_index;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 68px;
                            text: "监听地址";
                            font-size: 9pt;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }

                        LineEdit {
                            height: 28px;
                            text <=> root.add_listen_address;
                            placeholder-text: "0.0.0.0";
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 68px;
                            text: "监听端口";
                            font-size: 9pt;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }

                        LineEdit {
                            height: 28px;
                            text <=> root.add_listen_port;
                            placeholder-text: "8085";
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 68px;
                            text: "目标地址";
                            font-size: 9pt;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }

                        LineEdit {
                            height: 28px;
                            text <=> root.add_connect_address;
                            placeholder-text: "192.168.137.2";
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 68px;
                            text: "目标端口";
                            font-size: 9pt;
                            horizontal-alignment: right;
                        }

                        LineEdit {
                            height: 28px;
                            text <=> root.add_connect_port;
                            placeholder-text: "8085";
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Button {
                            height: 28px;
                            text: "保存";
                            primary: true;
                            enabled: root.add_listen_address != "" && root.add_listen_port != "" && root.add_connect_address != "" && root.add_connect_port != "";
                            clicked => { root.edit_mode ? root.edit_port_proxy(root.edit_proxy_type, root.edit_listen_address, root.edit_listen_port, root.add_proxy_type, root.add_listen_address, root.add_listen_port, root.add_connect_address, root.add_connect_port) : root.add_port_proxy(root.add_proxy_type, root.add_listen_address, root.add_listen_port, root.add_connect_address, root.add_connect_port); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        if (root.status_text != ""): Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;
            Rectangle {
                width: 360px;
                height: 128px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: root.status_text;
                        font-size: 10pt;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Button {
                            height: 26px;
                            text: "确定";
                            primary: true;
                            clicked => { root.status_text = ""; }
                        }
                    }
                }
            }
        }

        if (root.loading_visible): Rectangle {
            width: 100%;
            height: 100%;
            background: #00000099;
            Spinner {
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }
        }
    }
}
