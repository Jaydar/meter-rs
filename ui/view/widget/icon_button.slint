import { Palette } from "std-widgets.slint";

export component IconButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: transparent;

    icon_ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    Text { width: 100%; height: 100%; text: root.icon; color: Palette.control-foreground; font-size: 16px; font-family: "remixicon"; vertical-alignment: center; horizontal-alignment: center; }
}
