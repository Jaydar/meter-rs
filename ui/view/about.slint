import "../assets/remixicon.ttf";
import { Palette,StyleMetrics } from "std-widgets.slint";
import { Page } from "widget/page.slint";

export component AboutWindow inherits Page {
    width: 420px;
    height: 320px;
    background: Palette.background;

    in-out property <string> app_name;
    in-out property <string> version_text;
    in-out property <string> github_url;
    in-out property <string> oss_notice:
        "Built with Slint\nhttps://slint.dev\n\n使用到的开源包:\n- slint / i-slint-backend-winit\n- sysinfo\n- windows\n- anyhow\n- winit\n- raw-window-handle\n- Remix Icon\n\n请在分发时遵循各依赖许可证要求。";

    callback win_move(length, length);
    callback close_about();
    callback open_github();


        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            FlexboxLayout {
                flex-direction: FlexboxLayoutDirection.column;
                flex-wrap: FlexboxLayoutWrap.no-wrap;
                alignment: stretch;
                padding: 12px;
                spacing: 8px;


                Text {
                    text: root.version_text;
                    // color: Palette.default-text-color;
                    font-size: 9pt;
                }

                github_link := Rectangle {
                    height: 26px;
                    border-radius: 6px;
                    background: Palette.accent-foreground;

                    github_ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.open_github(); }
                    }

                    FlexboxLayout {
                        flex-direction: FlexboxLayoutDirection.row;
                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                        alignment: stretch;
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: root.github_url;
                            // color: StyleMetrics.default-text-color;
                            font-italic: true;
                            font-size: 9pt;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.background; }

                Text {
                    text: "开源声明";
                    // color: Theme.sub-title;
                    font-size: 10pt;
                    font-weight: 700;
                }

                Rectangle {
                    border-radius: 8px;
                    background: Palette.accent-foreground;
                    vertical-stretch: 1;

                    Text {
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                        text: root.oss_notice;
                        // color: StyleMetrics.default-text-color;
                        font-size: 9pt;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
        }

}
