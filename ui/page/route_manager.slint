import "../assets/remixicon.ttf";
import { Button, ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { NetworkAdapterEntry, RouteEntry } from "../runtime_store.slint";
import { Theme } from "../theme.slint";

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: self.enabled && icon_ta.has-hover ? Theme.menu-hover-bg : transparent;
    opacity: self.enabled ? 1 : 0.45;

    icon_ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.icon;
        color: icon_ta.has-hover ? Theme.menu-hover-fg : Theme.text;
        font-size: 16px;
        font-family: "remixicon";
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component RouteManagerWindow inherits Window {
    width: 504px;
    height: 756px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-size: 10pt;

    in-out property <[RouteEntry]> routes: [];
    in-out property <[NetworkAdapterEntry]> adapters: [];
    in-out property <[string]> adapter_names: [];
    in-out property <int> add_adapter_index: 0;
    in-out property <bool> add_adapter_menu_visible: false;
    in-out property <string> add_destination;
    in-out property <string> add_metric;
    in-out property <string> status_text;
    out property <string> add_adapter_id: root.adapters.length > 0 && root.add_adapter_index >= 0 && root.add_adapter_index < root.adapters.length ? root.adapters[root.add_adapter_index].id : "";
    out property <string> add_adapter_name: root.adapter_names.length > 0 && root.add_adapter_index >= 0 && root.add_adapter_index < root.adapter_names.length ? root.adapter_names[root.add_adapter_index] : "";

    callback win_move(length, length);
    callback close_route_manager();
    callback add_route(string, string, string);
    callback delete_route(string, string, string);

    root_ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: self.pressed ? MouseCursor.move : MouseCursor.default;

        moved => {
            root.win_move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            background: Theme.window-bg;
            border-width: 1px;
            border-color: Theme.menu-border;
            drop-shadow-blur: 16px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: "路由管理";
                        color: Theme.title;
                        font-size: 12pt;
                        font-weight: 800;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    close_btn := Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close_ta.has-hover ? Theme.menu-hover-bg : transparent;

                        close_ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.close_route_manager(); }
                        }

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{eb99}";
                            color: close_ta.has-hover ? Theme.menu-hover-fg : Theme.text;
                            font-size: 14px;
                            font-family: "remixicon";
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.menu-border;
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 4px;

                    Rectangle {
                        height: 22px;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: "目标"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; }
                            Text { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; text: "网卡"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; }
                            Text { width: 44px; text: "跃点"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; }
                            Text { width: 44px; text: "来源"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; }
                            Text { width: 28px; text: "操作"; color: Theme.sub-title; font-size: 9pt; font-weight: 800; }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;

                        for route in root.routes: Rectangle {
                            height: 32px;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 4px;
                                Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 100%; Text { width: 100%; height: 100%; text: route.destination; color: Theme.text; font-size: 9pt; vertical-alignment: center; overflow: elide; } }
                                Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 100%; Text { width: 100%; height: 100%; text: route.adapter; color: Theme.text; font-size: 9pt; vertical-alignment: center; overflow: elide; } }
                                Text { width: 44px; text: route.metric; color: Theme.text; font-size: 9pt; vertical-alignment: center; overflow: elide; }
                                Text { width: 44px; text: route.source; color: Theme.text; font-size: 9pt; vertical-alignment: center; overflow: elide; }
                                Rectangle { width: 28px; height: 100%; IconButton { y: (parent.height - self.height) / 2; icon: "\u{eb99}"; clicked => { root.delete_route(route.destination, route.interface_index, route.source); } } }
                            }

                            Rectangle { width: 100%; height: 1px; y: parent.height - 1px; background: Theme.menu-border; }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    background: Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.menu-border;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding: 6px;
                        spacing: 4px;
                        LineEdit { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 28px; text <=> root.add_destination; placeholder-text: "10.10.0.0/16"; }

                        Rectangle {
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 1;
                            height: 28px;
                            border-radius: 4px;
                            background: Theme.menu-bg;
                            border-width: 1px;
                            border-color: Theme.menu-border;

                            TouchArea {
                                enabled: root.adapters.length > 0;
                                mouse-cursor: root.adapters.length > 0 ? MouseCursor.pointer : MouseCursor.default;
                                clicked => { root.add_adapter_menu_visible = !root.add_adapter_menu_visible; }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.add_adapter_name;
                                    color: Theme.text;
                                    font-size: 9pt;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    width: 16px;
                                    text: "\u{ea4e}";
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-family: "remixicon";
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        LineEdit { width: 64px; height: 28px; text <=> root.add_metric; placeholder-text: "跃点"; }
                        IconButton { icon: "\u{ea13}"; enabled: root.add_destination != "" && root.add_adapter_id != ""; clicked => { root.add_route(root.add_destination, root.add_adapter_id, root.add_metric); } }
                    }
                }
            }

            if (root.add_adapter_menu_visible): Rectangle {
                width: 456px;
                height: 180px;
                x: 24px;
                y: 492px;
                border-radius: 6px;
                background: Theme.menu-bg;
                border-width: 1px;
                border-color: Theme.menu-border;
                drop-shadow-blur: 12px;

                ListView {
                    width: 100%;
                    height: 100%;

                    for adapter_name[index] in root.adapter_names: Rectangle {
                        height: 30px;
                        background: index == root.add_adapter_index ? Theme.menu-active-bg : adapter_ta.has-hover ? Theme.menu-hover-bg : transparent;

                        adapter_ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.add_adapter_index = index;
                                root.add_adapter_menu_visible = false;
                            }
                        }

                        Text {
                            width: 100%;
                            height: 100%;
                            x: 10px;
                            text: adapter_name;
                            color: adapter_ta.has-hover ? Theme.menu-hover-fg : Theme.text;
                            font-size: 9pt;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            if (root.status_text != ""): Rectangle {
                width: 100%;
                height: 100%;
                background: #00000066;

                Rectangle {
                    width: 360px;
                    height: 128px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.menu-border;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: root.status_text;
                            color: Theme.text;
                            font-size: 10pt;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                height: 26px;
                                text: "确定";
                                primary: true;
                                clicked => { root.status_text = ""; }
                            }
                        }
                    }
                }
            }
        }
    }
}
